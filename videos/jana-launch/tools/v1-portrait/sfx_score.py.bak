"""The Rally — sound score on onetake's palette (one material set, one room).
Every event is a beat in index.html's timeline; pans follow where the ball is on screen."""
import os, sys
sys.path.insert(0, os.path.expanduser("~/.claude/skills/onetake/scripts"))
from sfx_palette import Score, air, glass, wood, sub, bubble, pan_of

DUR = 20.6
s = Score(dur=DUR, T60=1.0)
P = lambda x: pan_of(x, 1080)

def bounce(t, f=200, g=0.5, x=540):
    """A tennis-ball 'pok': a short wooden knock with a soft felt thump under it."""
    s.place(wood(f, 0.10), t, g, P(x), 0.22)
    s.place(sub(68, 0.22), t, g * 0.45, 0.0, 0.1)

# 1 · serve: the painted ball peels up, the racket hits, the ball comes at the lens and back
s.place(air(0.55, 260, 1300, 1.3, 0.6), 1.00, 0.16, P(380), 0.45)
s.place(wood(150, 0.13), 1.55, 0.62, P(400), 0.25)
s.place(sub(62, 0.45), 1.55, 0.30, 0.0, 0.15)
s.place(air(0.45, 500, 3200, 1.2, 0.35), 1.58, 0.42, P(420), 0.4, pan_to=0.0)
s.place(air(0.70, 2600, 260, 1.3, 0.55), 2.02, 0.34, 0.0, 0.45, pan_to=P(380))

# 2 · rally: five bounces, pitch rising as it speeds up; a glass touch as each painting blooms
for t, f, x, gl in ((2.75, 190, 380, 523), (4.05, 205, 720, 587), (5.00, 220, 360, 659), (5.70, 235, 720, 784)):
    bounce(t, f, 0.55, x)
    s.place(glass(gl, 0.9, 0.6), t + 0.06, 0.07, P(x), 0.55)

# 3 · Ball on Blue: the landing is heavier, then near-silence while it melts in
bounce(6.20, 175, 0.62, 540)
s.place(sub(52, 1.1), 6.20, 0.32, 0.0, 0.3)
s.place(glass(1046, 1.6, 0.45), 6.75, 0.07, 0.0, 0.7)

# 4 · the home: pull-out breath, the ball lifts off the card and falls, then the cut burst on bounces
s.place(air(0.9, 2200, 280, 1.2, 0.5), 10.00, 0.22, 0.0, 0.5)
s.place(air(0.45, 300, 1500, 1.3, 0.6), 10.95, 0.16, P(620), 0.4)
s.place(air(0.40, 1800, 400, 1.3, 0.4), 11.35, 0.20, P(560), 0.4)
for t, x in ((11.75, 300), (12.25, 780), (12.84, 320), (13.55, 760), (14.00, 540)):
    bounce(t, 215, 0.50, x)
    s.place(air(0.18, 3000, 900, 1.6, 0.3), t - 0.01, 0.10, 0.0, 0.2)

# 5 · launching soon: a fall, one bounce on the red rule, a small settle into the full stop
s.place(air(0.5, 1800, 350, 1.3, 0.45), 14.90, 0.22, 0.0, 0.45)
bounce(15.40, 200, 0.52, 540)
bounce(15.80, 245, 0.28, 760)
s.place(bubble(560, 0.2), 15.82, 0.12, P(760), 0.3)
s.place(glass(784, 1.4, 0.5), 16.50, 0.08, -0.05, 0.6)
s.place(glass(1175, 1.4, 0.45), 16.52, 0.06, 0.05, 0.6)
s.place(wood(260, 0.07), 17.85, 0.14, 0.0, 0.2)

s.write(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "assets", "sfx.wav"), peak_db=-8.0)
print("wrote assets/sfx.wav")
