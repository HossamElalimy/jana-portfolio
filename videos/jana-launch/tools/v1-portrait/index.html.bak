      <audio data-hf-id="hf-l8ha" id="sfx" src="assets/sfx.wav" data-start="0" data-duration="20.6" data-volume="0.75" data-track-index="12"></audio>
    </div>

    <script>
      // Everything on screen is a pure function of t: render(t) is driven by one proxy tween.
      const W = 1080, AX = 540, AY = 1000, END = 20.6;
      const $ = (id) => document.getElementById(id);
      const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v));
      const lerp = (a, b, p) => a + (b - a) * p;
      const prog = (t, a, b) => clamp((t - a) / (b - a));
      const ease = {
        linear: (p) => p,
        sineOut: (p) => Math.sin((p * Math.PI) / 2),
        sineInOut: (p) => -(Math.cos(Math.PI * p) - 1) / 2,
        expoOut: (p) => (p >= 1 ? 1 : 1 - Math.pow(2, -10 * p)),
        expoInOut: (p) => (p <= 0 ? 0 : p >= 1 ? 1 : p < 0.5 ? Math.pow(2, 20 * p - 10) / 2 : (2 - Math.pow(2, -20 * p + 10)) / 2),
        backOut: (p) => { const c = 1.9; return 1 + (c + 1) * Math.pow(p - 1, 3) + c * Math.pow(p - 1, 2); },
      };

      // ── the plane: where each painting hangs (world px), and where the ball touches it ──
      const P = [
        { id: "p1", cx: 540, cy: 720, w: 840, h: 835.7 },
        { id: "p2", cx: 400, cy: 2200, w: 600, h: 601.5 },
        { id: "p3", cx: 690, cy: 3000, w: 560, h: 563.7 },
        { id: "p4", cx: 380, cy: 3800, w: 545, h: 576.3 },
        { id: "p5", cx: 700, cy: 4650, w: 470, h: 668 },
        { id: "p6", cx: 540, cy: 5450, w: 270, h: 268.9 },
      ];
      const BALL1 = { x: 120 + 0.3159 * 840, y: 720 - 835.7 / 2 + 0.4281 * 835.7, d: 0.1014 * 840 }; // painted ball in Figure in Motion
      // contacts sit low on each canvas, toward the next one, so the ball never lands on a face; the last is Ball on Blue's own ball
      const C = [ [520, 2362], [578, 3152], [489, 3956], [606, 4817], [540, 5440.95] ];
      const T = [2.75, 4.05, 5.0, 5.7, 6.2]; // the rally speeds up: 1.3 → 0.95 → 0.7 → 0.5
      const D = 120; // the ball on the plane = Ball on Blue's painted ball

      // ── camera: keyed where each beat needs it, eased like an operator chasing the ball ──
      const K = [
        { t: 0, cx: 420, cy: 690, z: 2.45 },
        { t: 1.0, cx: 418, cy: 688, z: 2.6, e: "sineInOut" },
        { t: 1.55, cx: 414, cy: 684, z: 2.68, e: "sineInOut" },
        { t: 2.04, cx: 540, cy: 700, z: 1.0, e: "expoOut" },
        { t: 2.05, cx: 540, cy: 700, z: 1.0 },
        { t: 2.07, cx: 400, cy: 2200, z: 1.05 }, // hidden: the ball fills the lens
        { t: 2.8, cx: 400, cy: 2200, z: 1.05 },
        { t: 4.17, cx: 690, cy: 3000, z: 1.08, e: "sineInOut" },
        { t: 5.12, cx: 380, cy: 3800, z: 1.1, e: "sineInOut" },
        { t: 5.82, cx: 700, cy: 4650, z: 1.08, e: "sineInOut" },
        { t: 6.34, cx: 540, cy: 5440.95, z: 3.185, e: "expoInOut" },
        { t: 7.3, cx: 540, cy: 5440.95, z: 3.9, e: "sineInOut" },
        { t: 10.0, cx: 540, cy: 5440.95, z: 3.9 }, // dead still: the rest that makes the burst land
        { t: 10.9, cx: 540, cy: 5450, z: 3.0, e: "expoInOut" },
        { t: END, cx: 540, cy: 5450, z: 3.0 },
      ];
      function cam(t) {
        let i = 0;
        while (i < K.length - 2 && t >= K[i + 1].t) i++;
        const a = K[i], b = K[i + 1];
        const p = (ease[b.e] || ease.linear)(prog(t, a.t, b.t));
        return { cx: lerp(a.cx, b.cx, p), cy: lerp(a.cy, b.cy, p), z: Math.exp(lerp(Math.log(a.z), Math.log(b.z), p)) };
      }
      const ALL_CONTACTS = [...T, 11.75, 12.25, 12.84, 13.55, 14.0, 15.4, 15.8];
      function shake(t) {
        let x = 0, y = 0;
        for (const tc of T) {
          const d = t - tc;
          if (d < 0 || d > 0.6) continue;
          const a = (tc === 6.2 ? 13 : 8) * Math.exp(-d / 0.13);
          x += a * Math.sin(2 * Math.PI * 9 * d) * 0.6;
          y += a * Math.sin(2 * Math.PI * 11 * d + 1);
        }
        // a hand on the camera: a slow float, still during the hold
        const hand = t < 6.3 ? 1 : t < 10 ? 0 : 0.6;
        x += hand * (3 * Math.sin(t * 1.3) + 2 * Math.sin(t * 2.9 + 1));
        y += hand * (3 * Math.sin(t * 1.1 + 2) + 2 * Math.sin(t * 2.3));
        return { x, y };
      }
      const squash = (t) => {
        let k = 1;
        for (const tc of ALL_CONTACTS) k -= 0.13 * Math.exp(-Math.pow((t - tc) / 0.035, 2));
        return k;
      };

      // ── the ball: one object, in plane coordinates or (for the lens, burst and end) on screen ──
      let END_DOT = { x: 760, y: 900, d: 60 }, RULE = { x: 540, y: 1035 };
      const BURST = [ [11.75, 300, 1560], [12.25, 780, 1500], [12.84, 320, 1580], [13.55, 770, 1520], [14.0, 540, 1600] ];
      function hop(t, t0, t1, height) {
        const s = prog(t, t0, t1);
        return { s, e: 4 * height * s * (1 - s) };
      }
      function ballState(t, c) {
        const project = (x, y, e) => ({ x: AX + ((x - c.cx) * c.z) / (1 - e), y: AY + ((y - c.cy) * c.z) / (1 - e) });
        // 0 – 1.55 · resting in the painting, then peeling up off the canvas
        if (t < 1.55) {
          const e = 0.25 * ease.sineOut(prog(t, 1.0, 1.5));
          const s = project(BALL1.x + 4 * prog(t, 1, 1.5), BALL1.y - 3 * prog(t, 1, 1.5), e);
          return { ...s, d: (BALL1.d * c.z) / (1 - e), e, tex: 0, op: 1, rot: 0 };
        }
        // 1.55 – 2.05 · served at the lens
        if (t < 2.05) {
          const q = prog(t, 1.55, 2.05);
          const e = 0.25 + 0.72 * Math.pow(q, 2.4);
          const s0 = project(BALL1.x + 4, BALL1.y - 3, 0.25);
          const p = Math.pow(q, 0.7);
          return { x: lerp(s0.x, 540, p), y: lerp(s0.y, 960, p), d: (lerp(BALL1.d, D, q) * c.z) / (1 - e), e, tex: clamp((q - 0.1) / 0.4), op: 1, rot: 200 * q };
        }
        // 2.05 – 2.75 · falling back onto the paper, under gravity
        if (t < T[0]) {
          const p = prog(t, 2.05, T[0]);
          const e = 0.97 * (1 - p * p);
          return { ...project(C[0][0], C[0][1], e), d: (D * c.z) / (1 - e), e, tex: 1, op: 1, rot: 200 + 160 * p };
        }
        // the rally: one turn per hop, so the ball lands on Ball on Blue exactly upright
        for (let i = 0; i < T.length - 1; i++) {
          if (t < T[i + 1]) {
            const { s, e } = hop(t, T[i], T[i + 1], 0.32 * (T[i + 1] - T[i]));
            const x = lerp(C[i][0], C[i + 1][0], s), y = lerp(C[i][1], C[i + 1][1], s);
            return { ...project(x, y, e), d: (D * c.z) / (1 - e), e, tex: 1, op: 1, rot: 360 * (1 + i + s) };
          }
        }
        // 6.2 – 10.95 · it lands in the painting and melts into its own painted ball
        if (t < 10.95) {
          return { ...project(C[4][0], C[4][1], 0), d: D * c.z, e: 0, tex: 1, op: 1 - prog(t, 6.55, 7.0), rot: 0 };
        }
        // 10.95 – 11.75 · the site's move: it lifts off the card and drops out of it
        const home = project(C[4][0], C[4][1], 0);
        if (t < 11.3) {
          const p = ease.sineOut(prog(t, 10.95, 11.3));
          const e = 0.25 * p;
          return { x: lerp(home.x, 610, p), y: lerp(home.y, 930, p), d: (D * 3) / (1 - e), e, tex: 1, op: prog(t, 10.95, 11.0), rot: 14 * p };
        }
        if (t < BURST[0][0]) {
          const p = prog(t, 11.3, BURST[0][0]);
          const e = 0.25 * (1 - p * p);
          return { x: lerp(610, BURST[0][1], p * p), y: lerp(930, BURST[0][2], p * p), d: lerp(D * 3, 150, p) / (1 - e), e, tex: 1, op: 1, rot: 14 + 120 * p };
        }
        // the burst: every bounce cuts to the next screen of the site
        for (let i = 0; i < BURST.length - 1; i++) {
          const [t0, x0, y0] = BURST[i], [t1, x1, y1] = BURST[i + 1];
          if (t < t1) {
            const { s, e } = hop(t, t0, t1, 0.3 * (t1 - t0));
            return { x: lerp(x0, x1, s), y: lerp(y0, y1, s), d: 150 / (1 - e), e, tex: 1, op: 1, rot: 134 + 300 * (i + s) };
          }
        }
        // 14.0 – 14.9 · up, out of the hero; 14.9 – 15.4 · down onto the red rule
        if (t < 14.9) {
          const p = ease.sineOut(prog(t, 14.0, 14.9));
          const e = 0.55 * p;
          return { x: 540, y: lerp(1600, 760, p), d: 150 / (1 - e), e, tex: 1, op: 1, rot: 1334 + 140 * p };
        }
        if (t < 15.4) {
          const p = prog(t, 14.9, 15.4);
          const e = 0.55 * (1 - p * p);
          return { x: 540, y: lerp(760, RULE.y - 75, p * p), d: 150 / (1 - e), e, tex: 1, op: 1, rot: 1474 + 120 * p };
        }
        // 15.4 – 15.8 · one hop into the full stop; 15.8 – 16.05 · a small settle
        if (t < 15.8) {
          const { s, e } = hop(t, 15.4, 15.8, 0.2);
          return { x: lerp(540, END_DOT.x, s), y: lerp(RULE.y - 75, END_DOT.y, s), d: lerp(150, END_DOT.d, s) / (1 - e), e, tex: 1, op: 1, rot: 1594 + 140 * s };
        }
        const { e } = hop(t, 15.8, 16.05, 0.035);
        return { x: END_DOT.x, y: END_DOT.y, d: END_DOT.d / (1 - e), e, tex: 1, op: 1, rot: 1734 };
      }

      // ── type helpers ──
      function slam(el, t, tin, tout) {
        if (t < tin || t > tout + 0.14) { el.style.opacity = 0; return; }
        const p = prog(t, tin, tin + 0.24), q = prog(t, tout, tout + 0.14);
        const sc = 1.28 - 0.28 * ease.backOut(p);
        el.style.opacity = clamp(p * 4) * (1 - q);
        el.style.transform = `translateY(${-46 * (1 - ease.expoOut(p)) + 22 * q}px) scale(${sc}, ${sc * (1 + 0.08 * (1 - p))})`;
      }
      function swapIn(el, t, tin, tout) {
        if (t < tin || t > tout + 0.12) { el.style.opacity = 0; return; }
        const p = ease.expoOut(prog(t, tin, tin + 0.3)), q = prog(t, tout, tout + 0.12);
        el.style.opacity = p * (1 - q);
        el.style.transform = `translateY(${26 * (1 - p) - 18 * q}px)`;
      }

      // ── render(t) ──
      const works = P.map((p) => $(p.id)), inners = P.map((p) => $(p.id).firstElementChild);
      const WORDS = [ ["w1", 2.85, 3.2], ["w2", 3.23, 4.12], ["w3", 4.17, 5.15], ["w4", 5.2, 6.05] ];
      const ROW = [ [0.3, 2.8], [2.8, 4.1], [4.1, 5.05], [5.05, 5.75], [5.75, 6.25], [6.25, 11.75] ];
      const SHOTS = ["s1", "s2", "s3", "s4", "s5"].map((id, i) => [$(id).firstElementChild, BURST[i][0]]);
      const ballEl = $("ball"), shadowEl = $("shadow"), b2 = $("b2");

      function render(t) {
        const c = cam(t), sh = shake(t);
        // ground + world
        const ox = AX - c.cx * c.z + sh.x, oy = AY - c.cy * c.z + sh.y;
        $("world").style.transform = `translate(${ox}px, ${oy}px) scale(${c.z})`;
        const scene = $("scene");
        scene.style.backgroundSize = `${512 * c.z * 0.5}px`;
        scene.style.backgroundPosition = `${ox}px ${oy}px`;
        P.forEach((p, i) => {
          const el = works[i];
          el.style.left = `${p.cx - p.w / 2}px`; el.style.top = `${p.cy - p.h / 2}px`;
          el.style.width = `${p.w}px`; el.style.height = `${p.h}px`;
          if (i === 0) { inners[0].style.clipPath = "none"; return; }
          // each painting grows out of the point where the ball touched it
          const r = Math.hypot(p.w, p.h) * ease.expoOut(prog(t, T[i - 1], T[i - 1] + 0.55));
          const cx = C[i - 1][0] - (p.cx - p.w / 2), cy = C[i - 1][1] - (p.cy - p.h / 2);
          inners[i].style.clipPath = `circle(${r.toFixed(2)}px at ${cx}px ${cy}px)`;
        });
        // the site's "Fine art" line slides behind the card
        const m = $("marquee");
        m.style.opacity = prog(t, 10.15, 10.55);
        m.style.transform = `translate(${-80 - (t - 10) * 300}px, ${AY - 200}px)`;

        // HUD
        WORDS.forEach(([id, a, b]) => slam($(id), t, a, b));
        const st = $("stub");
        st.style.opacity = prog(t, 2.9, 3.05) * (1 - prog(t, 6.0, 6.15));
        st.style.transform = `scaleX(${ease.expoOut(prog(t, 2.9, 3.2))})`;
        ROW.forEach(([a, b], i) => { swapIn($("l" + (i + 1)), t, a, b); swapIn($("r" + (i + 1)), t, a, i === 5 ? 10.3 : b); });
        swapIn($("r7"), t, 10.42, 11.75);
        $("hud").style.opacity = 1;

        // the site chrome
        const hp = ease.expoOut(prog(t, 10.25, 10.7));
        $("header").style.opacity = hp;
        $("header").style.transform = `translateY(${-30 * (1 - hp)}px)`;

        // burst: each screen lands with a small punch
        SHOTS.forEach(([img, t0]) => {
          const p = ease.expoOut(prog(t, t0, t0 + 0.3));
          img.style.transform = `scale(${1.07 - 0.07 * p})`;
        });

        // end card
        document.querySelectorAll("#wm .ch").forEach((ch, i) => {
          const a = 15.42 + i * 0.04, p = prog(t, a, a + 0.32);
          ch.style.opacity = clamp(p * 5);
          ch.style.transform = `translateY(${-70 * (1 - ease.backOut(p))}px) scaleY(${1 + 0.18 * (1 - p)})`;
        });
        const rp = t - 15.4;
        const wob = rp > 0 ? Math.exp(-rp / 0.14) * Math.sin(rp * 2 * Math.PI * 8) : 0;
        $("rule").style.transform = `scaleX(${ease.expoOut(prog(t, 14.95, 15.25)) * (1 + 0.12 * wob)}) scaleY(${1 - 0.35 * wob})`;
        [["ls1", 16.45], ["ls2", 16.92]].forEach(([id, a]) => {
          const p = ease.expoOut(prog(t, a, a + 0.45));
          $(id).style.transform = `translateY(${110 * (1 - p)}%)`;
        });
        [["url", 17.3], ["handle", 17.85]].forEach(([id, a]) => {
          const p = ease.expoOut(prog(t, a, a + 0.4));
          $(id).style.opacity = p;
          $(id).style.transform = `translateY(${20 * (1 - p)}px)`;
        });

        // the ball and its shadow
        const b = ballState(t, c);
        const sq = squash(t);
        const onPlane = t < 10.95 ? sh : { x: 0, y: 0 };
        const k = (b.d / 512) * sq;
        ballEl.style.opacity = b.op;
        ballEl.style.transform = `translate(${b.x - 256 + onPlane.x}px, ${b.y - 256 + onPlane.y}px) scale(${k}, ${k * (2 - sq)}) rotate(${b.rot}deg)`;
        b2.style.opacity = b.tex;
        // the shadow sits where the ball would touch, pushed away from the light as it rises
        const e = b.e, base = b.d * (1 - e);
        const sx = b.x + (34 + 520 * e) * (base / 120) * 0.35, sy = b.y + (52 + 760 * e) * (base / 120) * 0.35;
        const sk = (base * (1 + 0.5 * e)) / 512;
        shadowEl.style.opacity = b.op * 0.42 * Math.pow(1 - e, 1.6) * (t > 6.4 && t < 10.95 ? 0 : 1);
        shadowEl.style.transform = `translate(${sx - 256 + onPlane.x}px, ${sy - 256 + onPlane.y}px) scale(${sk * 1.05}, ${sk * 0.92})`;
        shadowEl.style.filter = `blur(${(3 + 40 * e).toFixed(1)}px)`;
      }

      // Layout that needs real glyph metrics: fit the rally words, place the end card's full stop.
      function layout() {
        document.querySelectorAll(".word").forEach((el) => {
          el.style.fontSize = "200px";
          const w = el.firstElementChild.getBoundingClientRect().width;
          el.style.fontSize = `${Math.min(200, Math.floor((200 * 900) / Math.max(1, w)))}px`;
        });
        const wm = $("wm");
        wm.style.fontSize = "100px";
        const chars = wm.querySelectorAll(".ch, #dotslot");
        const w100 = chars[chars.length - 1].getBoundingClientRect().right - chars[0].getBoundingClientRect().left;
        wm.style.fontSize = `${Math.min(300, Math.floor((100 * 880) / w100))}px`;
        const r = $("dotslot").getBoundingClientRect(), root = $("root").getBoundingClientRect();
        END_DOT = { x: r.left - root.left + r.width / 2, y: r.top - root.top + r.height / 2, d: r.width * 1.12 };
        const rule = $("rule").getBoundingClientRect();
        RULE = { x: 540, y: rule.top - root.top + 5 };
      }

      const state = { t: 0 };
      const build = () => {
        layout();
        const tl = gsap.timeline({ paused: true });
        tl.to(state, { t: END, duration: END, ease: "none", onUpdate: () => render(state.t) }, 0);
        render(0);
        window.__timelines["main"] = tl;
      };
      Promise.all([document.fonts.load("900 100px Archivo"), document.fonts.load("700 30px Archivo"), document.fonts.load("500 30px Archivo")]).then(build, build);
    </script>
  </body>
</html>
