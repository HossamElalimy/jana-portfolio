<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, height=1920" />
    <title>The Rally — JANA launching soon</title>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      @font-face{font-family:Archivo;font-style:normal;font-weight:100 900;font-stretch:100%;font-display:block;src:url("assets/fonts/captured-a2947afc6a06879b-s.138s14ivx2xer.woff2")format("woff2");unicode-range:U+102-103,U+110-111,U+128-129,U+168-169,U+1A0-1A1,U+1AF-1B0,U+300-301,U+303-304,U+308-309,U+323,U+329,U+1EA0-1EF9,U+20AB}
      @font-face{font-family:Archivo;font-style:normal;font-weight:100 900;font-stretch:100%;font-display:block;src:url("assets/fonts/captured-651aaf1801011892-s.3b2emle-7szv-.woff2")format("woff2");unicode-range:U+100-2BA,U+2BD-2C5,U+2C7-2CC,U+2CE-2D7,U+2DD-2FF,U+304,U+308,U+329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C4,U+2113,U+2C60-2C7F,U+A720-A7FF}
      @font-face{font-family:Archivo;font-style:normal;font-weight:100 900;font-stretch:100%;font-display:block;src:url("assets/fonts/captured-75affa71d1e2f6a7-s.p.13rul5q9jl2r0.woff2")format("woff2");unicode-range:U+??,U+131,U+152-153,U+2BB-2BC,U+2C6,U+2DA,U+2DC,U+304,U+308,U+329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}

      :root {
        --ink: #201e1d;
        --paper: #f3f2f2;
        --red: #ec3013;
        --muted: #5b5756;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1080px; height: 1920px; overflow: hidden; background: var(--paper); }
      #root {
        position: relative; width: 100%; height: 100%; overflow: hidden;
        background: var(--paper); color: var(--ink);
        font-family: Archivo, system-ui, sans-serif;
      }
      .clip { position: absolute; inset: 0; }

      /* ── the plane: paper ground, one long column of paintings, moved by the camera ── */
      #scene {
        overflow: hidden;
        background-color: var(--paper);
        background-image: url("assets/parts/paper-grain.png");
      }
      #marquee {
        position: absolute; left: 0; top: 0; white-space: nowrap;
        font-weight: 900; font-size: 470px; line-height: 0.8; letter-spacing: -0.045em;
        opacity: 0; will-change: transform;
      }
      #world { position: absolute; left: 0; top: 0; width: 1px; height: 1px; transform-origin: 0 0; }
      .work { position: absolute; filter: drop-shadow(0 16px 22px rgba(32, 30, 29, 0.2)); }
      .work .inner { position: absolute; inset: 0; overflow: hidden; }
      .work img { display: block; width: 100%; height: 100%; object-fit: cover; }

      /* ── screen-space type over the rally ── */
      .word {
        position: absolute; left: 0; right: 0; top: 1405px; text-align: center;
        font-weight: 900; line-height: 0.9; letter-spacing: -0.045em; white-space: nowrap;
        opacity: 0;
      }
      #stub { position: absolute; left: 500px; top: 1625px; width: 80px; height: 9px; background: var(--red); opacity: 0; }
      .row {
        position: absolute; left: 72px; right: 72px; top: 1728px; height: 44px;
        font-size: 30px; font-weight: 700; letter-spacing: -0.01em; overflow: hidden;
      }
      .row span { position: absolute; top: 0; white-space: nowrap; opacity: 0; }
      .row .r { right: 0; font-weight: 600; color: var(--muted); letter-spacing: 0.04em; }
      .row .l { left: 0; }

      /* ── the site, rebuilt around Ball on Blue ── */
      #header {
        position: absolute; left: 44px; right: 44px; top: 40px; height: 90px; opacity: 0;
      }
      #header .brand { position: absolute; left: 0; top: 0; font-weight: 900; font-size: 44px; line-height: 1; letter-spacing: -0.02em; }
      #header .sub { position: absolute; left: 0; top: 48px; font-weight: 500; font-size: 20px; }
      #header .menu { position: absolute; right: 0; top: 8px; font-weight: 600; font-size: 30px; }

      /* ── the burst: real phone screens of the site ── */
      .shot { overflow: hidden; background: var(--paper); }
      .shot img { position: absolute; left: 0; top: 0; width: 1080px; height: 1920px; transform-origin: 50% 55%; }

      /* ── end card ── */
      #end { background: var(--paper); }
      #wm {
        position: absolute; left: 0; right: 0; top: 600px; text-align: center;
        font-weight: 900; line-height: 0.82; letter-spacing: -0.05em; white-space: nowrap;
      }
      #wm .ch { display: inline-block; opacity: 0; }
      #dotslot { display: inline-block; width: 0.21em; height: 0.21em; margin-left: 0.07em; vertical-align: baseline; }
      #rule { position: absolute; left: 480px; top: 1030px; width: 120px; height: 10px; background: var(--red); transform-origin: 50% 50%; }
      #ls {
        position: absolute; left: 0; right: 0; top: 1110px; text-align: center;
        font-weight: 800; font-size: 112px; line-height: 1; letter-spacing: -0.04em; white-space: nowrap;
      }
      #ls .wd { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.12em; }
      #ls .wd span { display: inline-block; }
      #url { position: absolute; left: 0; right: 0; top: 1330px; text-align: center; font-weight: 700; font-size: 46px; letter-spacing: -0.01em; opacity: 0; }
      #handle { position: absolute; left: 0; right: 0; top: 1400px; text-align: center; font-weight: 500; font-size: 38px; color: var(--muted); opacity: 0; }

      /* ── the ball: one object for the whole film ── */
      #fx { pointer-events: none; }
      #shadow {
        position: absolute; left: 0; top: 0; width: 512px; height: 512px; border-radius: 50%;
        background: radial-gradient(closest-side, rgba(32, 30, 29, 0.55), rgba(32, 30, 29, 0) 100%);
        opacity: 0;
      }
      #ball { position: absolute; left: 0; top: 0; width: 512px; height: 512px; }
      #ball img { position: absolute; inset: 0; width: 512px; height: 512px; }
    </style>
  </head>
